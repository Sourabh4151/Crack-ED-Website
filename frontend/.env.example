# Point to Django backend (leads, quiz, job applications)
# Dev: http://localhost:8000  |  Production build: https://api.crack-ed.com
# Restart the dev server after changing this.
VITE_API_URL=http://127.0.0.1:8000

# Microsoft Clarity (heatmaps + session recordings). Leave empty to disable.
# Get the ID from https://clarity.microsoft.com/ → project Settings → Overview.
# Vite bakes this in at build time — set it before `npm run build` in production.
VITE_CLARITY_PROJECT_ID=
